{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "janji-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  // Reads Expo's push receipts, which say which phones can't be reached any more.
  "triggers": { "crons": ["*/15 * * * *"] },
  "ratelimits": [
    // Registrations per minute from one IP address.
    { "name": "REGISTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "kv_namespaces": [
    // Replaced with the ID `wrangler kv namespace create DEDUPE` prints, before the first deploy.
    { "binding": "DEDUPE", "id": "00000000000000000000000000000000" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "janji-relay",
      // Replaced with the ID `wrangler d1 create janji-relay` prints, before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
